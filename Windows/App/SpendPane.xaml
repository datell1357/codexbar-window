<UserControl x:Class="CodexBar.App.SpendPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexBar.App">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Usage &amp; Spend" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PeriodPicker" Header="Period" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="QueryChanged">
                    <ComboBoxItem Content="7 days" Tag="7" /><ComboBoxItem Content="30 days" Tag="30" />
                    <ComboBoxItem Content="90 days" Tag="90" /><ComboBoxItem Content="All collected (up to 365 days)" Tag="365" />
                </ComboBox>
                <ComboBox x:Name="CurrencyPicker" Grid.Column="1" Header="Currency group" HorizontalAlignment="Stretch"
                    SelectionChanged="CurrencyChanged" />
                <ComboBox x:Name="ChartPicker" Grid.Column="2" Header="Chart" SelectedIndex="0"
                    HorizontalAlignment="Stretch" SelectionChanged="QueryChanged">
                    <ComboBoxItem Content="Daily costs" Tag="cost" /><ComboBoxItem Content="Token activity (365 days)" Tag="tokens" />
                </ComboBox>
            </Grid>
            <TextBlock x:Name="StatusText" Text="Waiting for cost data…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel><TextBlock Text="Period cost" /><TextBlock x:Name="CostText" Text="Unknown" FontSize="28" /></StackPanel>
                <StackPanel><TextBlock Text="Period tokens" /><TextBlock x:Name="TokensText" Text="Unknown" FontSize="28" /></StackPanel>
            </StackPanel>
            <TextBlock x:Name="ContextText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <Canvas x:Name="ChartCanvas" Height="200" MinWidth="650" AutomationProperties.Name="Cost and token activity chart" />
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Previous day" Click="PreviousDay" />
                <Button Content="Next day" Click="NextDay" />
                <Button x:Name="HourlyButton" Content="Hourly details" Click="ShowHourly" IsEnabled="False" />
                <TextBlock x:Name="DayPosition" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="DayDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                AutomationProperties.LiveSetting="Polite" />
            <ComboBox x:Name="SectionPicker" Header="Breakdown" SelectedIndex="0" SelectionChanged="QueryChanged">
                <ComboBoxItem Content="Providers" Tag="providers" /><ComboBoxItem Content="Models" Tag="models" />
                <ComboBoxItem Content="Projects" Tag="projects" /><ComboBoxItem Content="Sessions" Tag="sessions" />
            </ComboBox>
            <ItemsControl x:Name="BreakdownList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SpendRow">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock Text="{x:Bind Cost}" /><TextBlock Text="{x:Bind Tokens}" /><TextBlock Text="tokens" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <Button Content="Models and details" Tag="{x:Bind SelectionIndex}" Click="OpenDetail"
                                    Visibility="{x:Bind DetailVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="PreviousPageButton" Content="Previous page" Click="PreviousPage" IsEnabled="False" />
                <TextBlock x:Name="PagePosition" VerticalAlignment="Center" />
                <Button x:Name="NextPageButton" Content="Next page" Click="NextPage" IsEnabled="False" />
            </StackPanel>
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="DetailTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <Button Content="Close details" Click="CloseDetail" />
                </StackPanel>
                <TextBlock x:Name="DetailContext" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Canvas x:Name="DetailCanvas" Height="200" MinWidth="650" AutomationProperties.Name="Selected cost detail chart" />
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Previous point" Click="PreviousDetailPoint" />
                    <Button Content="Next point" Click="NextDetailPoint" />
                    <TextBlock x:Name="DetailPointPosition" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DetailPointText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ItemsControl x:Name="DetailRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SpendRow">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind Cost}" /><TextBlock Text="{x:Bind Tokens}" /><TextBlock Text="tokens" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PreviousDetailButton" Content="Previous detail page" Click="PreviousDetailPage" />
                    <TextBlock x:Name="DetailPagePosition" VerticalAlignment="Center" />
                    <Button x:Name="NextDetailButton" Content="Next detail page" Click="NextDetailPage" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
