<UserControl x:Class="CodexBar.App.SpendPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexBar.App">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Usage &amp; Spend" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PeriodPicker" Header="Period" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="QueryChanged">
                    <ComboBoxItem Content="7 days" Tag="7" /><ComboBoxItem Content="30 days" Tag="30" />
                    <ComboBoxItem Content="90 days" Tag="90" /><ComboBoxItem Content="All collected (up to 365 days)" Tag="365" />
                </ComboBox>
                <ComboBox x:Name="CurrencyPicker" Grid.Column="1" Header="Currency group" HorizontalAlignment="Stretch"
                    SelectionChanged="CurrencyChanged" />
                <ComboBox x:Name="ChartPicker" Grid.Column="2" Header="Chart" SelectedIndex="0"
                    HorizontalAlignment="Stretch" SelectionChanged="QueryChanged">
                    <ComboBoxItem Content="Daily costs" Tag="cost" /><ComboBoxItem Content="Token activity (365 days)" Tag="tokens" />
                </ComboBox>
            </Grid>
            <TextBlock x:Name="StatusText" Text="Waiting for cost data…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel><TextBlock Text="Period cost" /><TextBlock x:Name="CostText" Text="Unknown" FontSize="28" /></StackPanel>
                <StackPanel><TextBlock Text="Period tokens" /><TextBlock x:Name="TokensText" Text="Unknown" FontSize="28" /></StackPanel>
            </StackPanel>
            <TextBlock x:Name="ContextText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <StackPanel Spacing="8">
                <TextBlock Text="Share or export this period and currency" FontWeight="SemiBold" />
                <TextBlock Text="Share cards use public provider and model names. Cost JSON includes source IDs and labels when Hide personal info is off. Exports cover the selected period, even when the token chart shows 365 days."
                    TextWrapping="Wrap" />
                <StackPanel x:Name="ShareActions" Orientation="Horizontal" Spacing="8" IsEnabled="False">
                    <Button Content="Preview card" Tag="preview" Click="ExportClicked" />
                    <Button Content="Copy text" Tag="copyText" Click="ExportClicked" />
                    <Button Content="Copy image" Tag="copyImage" Click="ExportClicked" />
                    <Button Content="Save PNG" Tag="saveImage" Click="ExportClicked" />
                </StackPanel>
                <StackPanel x:Name="JSONActions" Orientation="Horizontal" Spacing="8" IsEnabled="False">
                    <Button Content="Copy cost JSON" Tag="copyJSON" Click="ExportClicked" />
                    <Button Content="Save cost JSON" Tag="saveJSON" Click="ExportClicked" />
                </StackPanel>
                <TextBlock x:Name="ExportStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ToggleSwitch x:Name="CompareToggle" Header="Compare rolling periods" Toggled="ComparisonChanged" />
            <StackPanel x:Name="ComparisonPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Text="These periods overlap and share the collection date. Totals use the currently selected currency group and included sources."
                    TextWrapping="Wrap" />
                <ItemsControl x:Name="ComparisonRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SpendComparisonRow">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Range}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind Cost}" /><TextBlock Text="{x:Bind Tokens}" /><TextBlock Text="tokens" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Coverage}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button Content="Show this period" Tag="{x:Bind Days}" Click="ShowComparisonPeriod" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ToggleSwitch x:Name="CodexModelsToggle" Header="Codex models, effort and session references" Toggled="CodexModelsChanged" />
            <StackPanel x:Name="CodexModelsPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock x:Name="CodexModelsContext" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="Current period" FontWeight="SemiBold" />
                <TextBlock x:Name="CodexModelsCurrentRange" TextWrapping="Wrap" />
                <TextBlock Text="Previous period" FontWeight="SemiBold" />
                <TextBlock x:Name="CodexModelsPreviousRange" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="AllCodexModelsButton" Content="All models" Click="ClearCodexModel" />
                    <Button Content="No models" Click="ClearAllCodexModels" />
                    <TextBlock x:Name="CodexModelScope" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <Expander Header="Choose models" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Include specific models, or exclude models from the full set. The model table and timeline use the same selection." TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CodexModelChoices">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:CodexModelChoice">
                                        <Grid ColumnSpacing="12" Padding="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SelectionLabel}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="{x:Bind ActionTitle}" Tag="{x:Bind Index}" Click="ToggleCodexModel" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PreviousCodexCatalogButton" Content="Previous choices" Click="PreviousCodexCatalogPage" />
                            <TextBlock x:Name="CodexCatalogPosition" VerticalAlignment="Center" />
                            <Button x:Name="NextCodexCatalogButton" Content="Next choices" Click="NextCodexCatalogPage" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Text="Model CSV contains all selected model rows and the selected timeline, including rows on other pages. Missing and incomplete values have explicit status columns. Hide personal info also applies to this export."
                    TextWrapping="Wrap" />
                <StackPanel x:Name="CodexCSVActions" Orientation="Horizontal" Spacing="8" IsEnabled="False">
                    <Button Content="Copy model CSV" Tag="copyModelsCSV" Click="ExportClicked" />
                    <Button Content="Save model CSV" Tag="saveModelsCSV" Click="ExportClicked" />
                </StackPanel>
                <TextBlock Text="Current-period model timeline" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="CodexGranularityPicker" Header="Interval" SelectedIndex="0" SelectionChanged="CodexTimelineChanged">
                        <ComboBoxItem Content="Daily" Tag="daily" />
                        <ComboBoxItem Content="Weekly" Tag="weekly" />
                        <ComboBoxItem Content="Monthly" Tag="monthly" />
                    </ComboBox>
                    <ComboBox x:Name="CodexMetricPicker" Header="Timeline metric" SelectedIndex="0" SelectionChanged="CodexTimelineChanged">
                        <ComboBoxItem Content="Tokens" Tag="tokens" />
                        <ComboBoxItem Content="Known cost" Tag="cost" />
                        <ComboBoxItem Content="Session references" Tag="sessionReferences" />
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="CodexTimelineContext" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Canvas x:Name="CodexTimelineCanvas" Height="200" AutomationProperties.Name="Codex model timeline" />
                </ScrollViewer>
                <TextBlock x:Name="CodexTimelineDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PreviousCodexPointButton" Content="Previous interval" Click="PreviousCodexPoint" />
                    <TextBlock x:Name="CodexTimelinePosition" VerticalAlignment="Center" />
                    <Button x:Name="NextCodexPointButton" Content="Next interval" Click="NextCodexPoint" />
                </StackPanel>
                <ItemsControl x:Name="CodexModelsRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:CodexModelRow">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Button Content="Focus this model" Tag="{x:Bind SelectionIndex}" Click="FocusCodexModel" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Current sessions" Tag="{x:Bind SelectionIndex}" Click="OpenCurrentCodexSessions" />
                                        <Button Content="Previous sessions" Tag="{x:Bind SelectionIndex}" Click="OpenPreviousCodexSessions" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Metric" /><TextBlock Grid.Column="1" Text="Current" />
                                        <TextBlock Grid.Column="2" Text="Previous" /><TextBlock Grid.Column="3" Text="Change" />
                                        <TextBlock Grid.Row="1" Text="Tokens" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind CurrentTokens}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind PreviousTokens}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind TokenChange}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Text="Known cost" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind CurrentCost}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Bind PreviousCost}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Bind CostChange}" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PreviousCodexModelsButton" Content="Previous model page" Click="PreviousCodexModelsPage" />
                    <TextBlock x:Name="CodexModelsPosition" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="NextCodexModelsButton" Content="Next model page" Click="NextCodexModelsPage" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <Canvas x:Name="ChartCanvas" Height="200" MinWidth="650" AutomationProperties.Name="Cost and token activity chart" />
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Previous day" Click="PreviousDay" />
                <Button Content="Next day" Click="NextDay" />
                <Button x:Name="HourlyButton" Content="Hourly details" Click="ShowHourly" IsEnabled="False" />
                <TextBlock x:Name="DayPosition" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="DayDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                AutomationProperties.LiveSetting="Polite" />
            <ComboBox x:Name="SectionPicker" Header="Breakdown" SelectedIndex="0" SelectionChanged="QueryChanged">
                <ComboBoxItem Content="Providers" Tag="providers" /><ComboBoxItem Content="Models" Tag="models" />
                <ComboBoxItem Content="Projects" Tag="projects" /><ComboBoxItem Content="Sessions" Tag="sessions" />
            </ComboBox>
            <ItemsControl x:Name="BreakdownList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SpendRow">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBlock Text="{x:Bind Cost}" /><TextBlock Text="{x:Bind Tokens}" /><TextBlock Text="tokens" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <Button Content="Models and details" Tag="{x:Bind SelectionIndex}" Click="OpenDetail"
                                    Visibility="{x:Bind DetailVisibility}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="PreviousPageButton" Content="Previous page" Click="PreviousPage" IsEnabled="False" />
                <TextBlock x:Name="PagePosition" VerticalAlignment="Center" />
                <Button x:Name="NextPageButton" Content="Next page" Click="NextPage" IsEnabled="False" />
            </StackPanel>
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="DetailTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <Button Content="Close details" Click="CloseDetail" />
                    <Button x:Name="BackCodexSessionsButton" Content="Back to session references" Click="BackToCodexSessions" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="DetailContext" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Canvas x:Name="DetailCanvas" Height="200" MinWidth="650" AutomationProperties.Name="Selected cost detail chart" />
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Previous point" Click="PreviousDetailPoint" />
                    <Button Content="Next point" Click="NextDetailPoint" />
                    <TextBlock x:Name="DetailPointPosition" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DetailPointText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ItemsControl x:Name="DetailRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SpendRow">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind Cost}" /><TextBlock Text="{x:Bind Tokens}" /><TextBlock Text="tokens" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button Content="Session details" Tag="{x:Bind SelectionIndex}" Click="OpenCodexSession"
                                        Visibility="{x:Bind DetailVisibility}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PreviousDetailButton" Content="Previous detail page" Click="PreviousDetailPage" />
                    <TextBlock x:Name="DetailPagePosition" VerticalAlignment="Center" />
                    <Button x:Name="NextDetailButton" Content="Next detail page" Click="NextDetailPage" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
